# ============================================================================
# EVAL SHEET: "Brightness 1/2" — side-lit sphere at the origin
# ============================================================================
# Requirement (verbatim): "Place a sphere at the coordinates {0, 0, 0}, the
# camera facing the sphere, and put a spot to the left or right of the
# camera but positioned in such a way that the sphere will be lit from the
# side. Display the rendered image. The sphere should be visible,
# illuminated, and displayed without glitching."
# The point of "from the side" rather than from the camera position is to
# force a visible terminator (light/shadow boundary) across the sphere's
# face — a light co-located with the camera would just flatly floodlight
# the visible hemisphere and couldn't reveal a broken diffuse (N·L) term.

#ambient strength/ratio RGB_col( , , )
A 0.2 255,255,255

#camera pos( , , ) camera_dir( , , ) field_of_view(in deg)
C 0,0,-10 0,0,1 70

#L pos( , , ) brightness_ratio RGB_col( , , )
# Light sits well to the left of the camera (x=-8) and pulled forward to
# roughly the sphere's depth (z=-2, vs. the camera's z=-10), so the ray from
# light to sphere-surface arrives from the side rather than head-on.
L -8,0,-2 0.8 255,255,255

#sp sphere_center( , , ) diameter RGB_colour( , , )
sp 0,0,0 4 255,0,0
