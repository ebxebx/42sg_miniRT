# ============================================================================
# EVAL SHEET: "The Basic Shapes" — sphere test
# ============================================================================
# Requirement (verbatim): "Place a sphere at the coordinates {0, 0, 0}. With
# the camera facing the sphere, display the rendered image. The sphere should
# be visible and displayed without glitching."
# Fail this test and the whole "Basic Shapes" section scores 0 — keep it as
# bare-bones as possible so a glitch can only mean a sphere-intersection bug,
# not something confused by other geometry in the scene.

#ambient strength/ratio RGB_col( , , )
A 0.2 255,255,255

#camera pos( , , ) camera_dir( , , ) field_of_view(in deg)
# Camera sits 10 units back on -z, looking straight down +z at the origin —
# the sphere is dead center in frame, nothing else to distract from it.
C 0,0,-10 0,0,1 70

#L pos( , , ) brightness_ratio RGB_col( , , )
L -5,5,-5 0.8 255,255,255

#sp sphere_center( , , ) diameter RGB_colour( , , )
# Centre exactly {0,0,0} as the eval sheet requires. Diameter 4 (radius 2)
# is large enough to fill a good chunk of the frame at fov 70 / distance 10.
sp 0,0,0 4 255,0,0
