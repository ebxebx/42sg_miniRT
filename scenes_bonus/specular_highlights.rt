# Phong specular highlight demonstration.
# Low ambient light keeps the highlights crisp and easy to compare.
A 0.05 255,255,255

# Slightly elevated camera facing the centre sphere.
C 0,1,-12 0,-0.05,1 60

# Warm key and cool fill lights produce distinct coloured highlights.
L -5,6,-4 0.75 255,220,180
L 5,3,-2 0.45 120,170,255

# Neutral floor catches the objects' shadows.
pl 0,-2,0 0,1,0 90,90,100

# Dark surfaces make the light-independent specular colour stand out.
sp 0,0,4 4 80,80,80
sp -4,-0.8,7 2.2 210,65,75
cy 4,-0.5,7 0,1,0 2.2 3 55,155,215

# Small blocker demonstrates that occluded lights add no highlight.
sp -2.5,3,0 1.2 35,35,40
